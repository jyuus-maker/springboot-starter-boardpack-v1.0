DB_URL=jdbc:postgresql://localhost:5432/tinyboard_db
DB_USERNAME=각자 만든 DB 사용자 이름
DB_PASSWORD=그 사용자의 비밀번호
# Docker DB의 호스트 포트. 바꾸면 위 DB_URL의 포트도 함께 맞춥니다.
DB_PORT=5432
JWT_SECRET=32바이트 이상 랜덤 Base64 (생성 방법은 README)
# 분리 배포 프론트의 Origin. 여러 주소는 쉼표로 구분합니다.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
